# AI Customer Support Platform — environment template
# Copy to .env and fill real values locally. NEVER put real secrets in this file.
# Full contract: Documentation/ENVIRONMENT_VARIABLES.md

# --- App ---
NODE_ENV=development
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- PostgreSQL (local on E:, ADR-011) ---
DATABASE_URL=postgres://aicsp:change-me@127.0.0.1:5432/ai_csp
DATABASE_POOL_MAX=10
DB_SSL=false

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=aicsp
JOB_MAX_ATTEMPTS=5

# --- Object storage (MinIO local) ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_FILES=aicsp-files
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# --- Email (Mailpit mock until D-05 decided) ---
EMAIL_PROVIDER=mailpit-mock
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost
EMAIL_WEBHOOK_SECRET=change-me

# --- AI providers (MOCK ONLY until spending cap approved — D-04 open) ---
AI_PROVIDER_MODE=mock
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=15000
EMBEDDING_MODEL=
AI_MONTHLY_BUDGET_CAP_USD=

# --- Voice (mock until D-06/D-10 decided) ---
VOICE_PROVIDER_MODE=mock
VOICE_PROVIDER_SID=
VOICE_AUTH_TOKEN=
VOICE_WEBHOOK_SECRET=
VOICE_RECORDING_ENABLED=false

# --- Operator (P6) ---
PLATFORM_OPERATOR_TOKEN=
SENTRY_DSN=
